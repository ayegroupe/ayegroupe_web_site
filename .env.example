# Copier ce fichier en ".env" en local, et renseigner les memes valeurs
# dans Vercel > Project Settings > Environment Variables pour la production.
#
# Ces valeurs se trouvent dans Supabase > Project Settings > API.
# La cle "anon" est publique par design (protegee par les policies RLS
# de la table contact_submissions, voir supabase/schema.sql) : c'est
# pourquoi le prefixe PUBLIC_ est correct ici et n'expose aucun secret.

PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Analytics 4 (optionnel). Si cette variable est absente, GA4 n'est pas
# charge et la banniere de consentement ne s'affiche pas (aucun cookie depose).
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
