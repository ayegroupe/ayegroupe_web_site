---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const pillars = [
  {
    title: 'Sourcing International & Négociation Fournisseurs',
    desc: 'Recherche et sélection d\'usines et de fournisseurs certifiés en Europe, Asie et Amérique pour l\'approvisionnement de vos marchandises au meilleur rapport qualité/prix.',
    bullets: ['Vérification d\'audit d\'usines et conformité des normes', 'Négociation des conditions d\'achat et des délais de production', 'Inspection pré-embarquement et contrôle de conformité'],
  },
  {
    title: 'Importation & Acheminement Multimodal',
    desc: 'Prise en charge complète de vos cargaisons maritimes (FCL/LCL conteneurs) et aériennes à destination du Port Autonome de Lomé (PAL) ou de l\'Aéroport International Gnassingbé Eyadéma (AIGE).',
    bullets: ['Gestion des Incoterms (FOB, CIF, DAP, DDP)', 'Suivi en temps réel des connaissements et manifestes', 'Coordination logistique avec les compagnies maritimes et aériennes'],
  },
  {
    title: 'Facilitation Douanière & Dédouanement',
    desc: 'Accompagnement rigoureux pour franchir les étapes administratives et douanières togolaises en conformité avec le Guichet Unique pour le Commerce Extérieur (GUCE).',
    bullets: ['Préparation et contrôle des liasses documentaires', 'Optimisation tarifaire selon le tarif douanier de la CEDEAO', 'Suivi de mainlevée rapide pour éviter les surestaries'],
  },
  {
    title: 'Exportation de Produits Régionaux',
    desc: 'Valorisation et expédition de produits agro-industriels, matières premières et productions ouest-africaines vers les marchés mondiaux.',
    bullets: ['Conditionnement aux normes phytosanitaires internationales', 'Traçabilité des lots et certificats d\'origine', 'Gestion des flux documentaires bancaires (Crédit documentaire, remise)'],
  },
];
---

<BaseLayout
  title="General Trade & Import-Export au Togo | AYEGROUPE"
  description="Opérations de négoce international, sourcing fournisseurs, fret maritime/aérien et transit douanier à Lomé par AYEGROUPE."
  lang="fr"
  canonicalPath="/fr/togo/import-export"
>
  <section class="bg-brand-navy py-16 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <a href="/fr/togo" class="text-xs font-bold text-brand-gold hover:underline uppercase tracking-wider">&larr; Retour au Pôle Togo</a>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
          General Trade & Négoce International
        </h1>
        <p class="text-slate-300 text-base sm:text-lg">
          Votre passerelle commerciale mondiale : nous sourçons, négocions, transportons et dédouanons vos marchandises au Togo avec une rigueur absolue.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {pillars.map((p) => (
          <div class="rounded-3xl bg-white border border-slate-200/80 p-8 shadow-sm hover:shadow-card-hover transition-all">
            <h3 class="text-xl font-bold text-brand-navy mb-3">{p.title}</h3>
            <p class="text-slate-600 text-sm mb-6 leading-relaxed">{p.desc}</p>
            <ul class="space-y-2 border-t border-slate-100 pt-4">
              {p.bullets.map((b) => (
                <li class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-gold flex-shrink-0"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-12 p-8 rounded-3xl bg-brand-navy text-white flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white">Un projet d'importation ou de sourcing spécifique ?</h3>
          <p class="text-slate-400 text-sm mt-1">Échangez directement avec notre pôle commerce international.</p>
        </div>
        <a
          href="/fr/contact?service=import-export"
          class="px-6 py-3.5 rounded-xl bg-brand-gold hover:bg-brand-gold-dark text-slate-950 font-bold text-sm shadow-lg whitespace-nowrap"
        >
          Contacter notre pôle négoce
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
