---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/ContactForm.astro';
---

<BaseLayout
  title="Contactez AYEGROUPE — Devis, Conseil & Opérations"
  description="Prenez contact avec les équipes d'AYEGROUPE pour vos projets d'ingénierie logicielle ou vos besoins logistiques et d'équipements à Lomé, Togo."
  lang="fr"
  canonicalPath="/fr/contact"
>
  <!-- Header Banner -->
  <section class="bg-brand-navy py-16 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-slate-300 font-mono">
          Écoute & Réactivité
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
          Entrons en Contact
        </h1>
        <p class="text-slate-300 text-base sm:text-lg">
          Nos spécialistes IT et logistiques sont à votre disposition pour analyser vos besoins et vous transmettre un devis détaillé sous 24h.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Section: Form & Contacts -->
  <section class="py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Details & Direct Channels -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="rounded-3xl bg-white border border-slate-200/80 p-8 shadow-sm space-y-6">
            <h3 class="text-xl font-bold text-brand-navy">Coordonnées Directes</h3>
            
            <!-- WhatsApp -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.067-1.118-.067-.323-.102-.734-.239-1.266-.469-2.228-.962-3.682-3.23-3.794-3.379-.111-.148-.908-1.206-.908-2.302 0-1.096.575-1.636.78-1.859.183-.2.433-.277.674-.277.081 0 .153.004.218.008.192.008.318.038.459.378.175.422.597 1.455.65 1.562.053.107.088.232.018.373-.07.142-.105.231-.21.353-.105.123-.22.274-.314.368-.105.105-.215.22-.092.43.123.211.547.902 1.174 1.46 1.066.949 1.939 1.258 2.213 1.394.275.137.436.115.597-.07.162-.185.69-.803.874-1.079.183-.276.368-.231.614-.14.246.091 1.559.734 1.825.867.266.133.444.198.508.307.065.108.065.632-.079 1.037z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">WhatsApp Professionnel</span>
                <a
                  href="https://wa.me/22890000000"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-bold text-emerald-600 hover:underline"
                >
                  +228 90 00 00 00 (Lomé, Togo)
                </a>
                <p class="text-xs text-slate-500 mt-0.5">Réponse instantanée durant les heures ouvrées.</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 text-brand-blue flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Email Officiel</span>
                <a href="mailto:contact@ayegroupe.com" class="text-sm font-bold text-brand-navy hover:text-brand-blue">
                  contact@ayegroupe.com
                </a>
                <p class="text-xs text-slate-500 mt-0.5">Pour devis, appels d'offres et partenariats.</p>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-50 text-brand-gold-dark flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Implantation Locale</span>
                <span class="text-sm font-bold text-brand-navy">Lomé, République Togolaise</span>
                <p class="text-xs text-slate-500 mt-0.5">Opérations logistiques, livraisons et rendez-vous clients.</p>
              </div>
            </div>
          </div>

          <!-- Quick FAQ / Support reminder -->
          <div class="p-6 rounded-3xl bg-brand-navy text-white space-y-3">
            <h4 class="text-sm font-bold text-brand-gold flex items-center gap-2">
              <span>⚡</span> Horaires & Disponibilité
            </h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              * **Pôle Togo** : Du Lundi au Vendredi, 08h00 &ndash; 18h00 GMT.<br/>
              * **Pôle IT & Support SaaS** : Supervision continue 24/7 pour les infrastructures critiques et abonnements actifs.
            </p>
          </div>

        </div>

        <!-- Right: Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm lang="fr" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
