---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoleSelector from '../../components/PoleSelector.astro';
import SaasShowcase from '../../components/SaasShowcase.astro';
import ContactForm from '../../components/ContactForm.astro';
import LegalAccordion from '../../components/LegalAccordion.astro';

const metrics = [
  { value: '02', label: 'Pôles d\'Excellence', sub: 'IT Global & Hub Togo' },
  { value: '02', label: 'Produits SaaS en Ligne', sub: 'AyePrep & AyeJob' },
  { value: '38', label: 'Activités Habilitées', sub: 'Nomenclature officielle' },
  { value: '24/7', label: 'Disponibilité & Support', sub: 'Lomé & Remote international' },
];
---

<BaseLayout
  title="Ingénierie Logicielle, Négoce & Logistique Internationale"
  description="AYEGROUPE conjugue le développement logiciel d'entreprise à l'échelle internationale et la puissance logistique et commerciale de son hub à Lomé, Togo."
  lang="fr"
  canonicalPath="/fr"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#F4F6F9] via-white to-white overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-36 border-b border-slate-200/80">
    <!-- Ambient Technical Grid -->
    <div class="absolute inset-0 bg-grid-sky opacity-40 pointer-events-none"></div>
    
    <!-- Subtle Forex Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-emerald-100/30 rounded-full blur-[130px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        
        <!-- Status Pill (Forex.com Live Indicator Style) -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-[11px] font-bold uppercase tracking-wider text-[#0C2340]">
          <span class="w-2 h-2 rounded-full bg-[#00A859] animate-pulse"></span>
          <span>Entreprise Individuelle · Double Pôle d'Expertise Stratégique</span>
        </div>

        <!-- Main H1 Title -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[#0C2340] leading-[1.08]">
          L'Excellence <span class="text-gradient-tech">Technologique</span> & la Puissance <span class="text-[#0C2340]">Logistique</span>
        </h1>

        <!-- Subtitle / Value proposition -->
        <p class="text-base sm:text-lg text-[#2C3E50] leading-relaxed max-w-3xl mx-auto font-normal">
          <strong class="text-[#0C2340] font-semibold">AYEGROUPE</strong> orchestre une synergie d'affaires éprouvée : la conception et l'exploitation de solutions logicielles de pointe à l'échelle internationale et des opérations physiques de référence au Togo (Négoce, Fourniture IT et Logistique d'entreprise).
        </p>

        <!-- CTAs - Forex.com Pill Action Buttons -->
        <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/fr/services-it"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs uppercase tracking-wider shadow-sm hover:shadow-md transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            Découvrir le Pôle IT & Logiciel
          </a>
          <a
            href="/fr/togo"
            class="w-full sm:w-auto px-8 py-3 rounded-full bg-white hover:bg-[#0C2340] text-[#0C2340] hover:text-white font-bold text-xs uppercase tracking-wider border-2 border-[#0C2340] transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            Explorer le Pôle Togo & Logistique
          </a>
          <a
            href="/fr/saas"
            class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-slate-100 hover:bg-slate-200 text-[#0C2340] font-bold text-xs uppercase tracking-wider transition-all duration-150 hover:-translate-y-0.5 text-center"
          >
            Nos SaaS en ligne &rarr;
          </a>
        </div>

        <!-- Metrics ribbon (Forex.com High Precision Trading Metric Style) -->
        <div class="pt-12 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 border-t border-slate-200 mt-12">
          {metrics.map((m) => (
            <div class="p-5 rounded-2xl bg-white border border-slate-200 text-center shadow-xs hover:border-[#00A859]/50 hover:shadow-sm transition-all">
              <div class="text-3xl sm:text-4xl font-bold font-mono text-[#00A859] mb-1 tracking-tight">{m.value}</div>
              <div class="text-xs font-bold uppercase tracking-wider text-[#0C2340]">{m.label}</div>
              <div class="text-[11px] text-slate-500 font-medium mt-0.5">{m.sub}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Section Pôles d'activité -->
  <section class="py-20 lg:py-28 bg-white relative border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3.5">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-[#0C2340] border border-slate-200">
          Architecture du Groupe
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0C2340] tracking-tight">
          Deux Pôles Stratégiques, Une Même Rigueur
        </h2>
        <p class="text-[#2C3E50] text-base sm:text-lg leading-relaxed">
          Nous séparons nos messages pour répondre avec une précision chirurgicale aux impératifs respectifs de nos partenaires mondiaux et régionaux.
        </p>
      </div>

      <PoleSelector lang="fr" />

    </div>
  </section>

  <!-- Section SaaS Vitrine (AyePrep & AyeJob) -->
  <section class="py-20 lg:py-28 bg-[#F4F6F9] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-20 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3.5">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200">
          Preuve de Compétence Technique
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0C2340] tracking-tight">
          Nos Solutions SaaS en Production
        </h2>
        <p class="text-[#2C3E50] text-base sm:text-lg leading-relaxed">
          Nous ne faisons pas que développer pour autrui : nous architecturons, exploitons et monétisons nos propres plateformes haute performance.
        </p>
      </div>

      <SaasShowcase lang="fr" showCta={true} />
    </div>
  </section>

  <!-- Section Légale & Activités déclarées -->
  <section class="py-16 lg:py-24 bg-white text-[#0C2340] relative border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0C2340] tracking-tight">
          Transparence & Cadre Légal AYEGROUPE
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Consultez le périmètre officiel des 38 activités d'ingénierie, de négoce et de logistique habilitées pour l'entreprise.
        </p>
      </div>

      <LegalAccordion lang="fr" />
    </div>
  </section>

  <!-- Quick Contact Section -->
  <section class="py-20 lg:py-28 bg-[#F4F6F9] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200">
            Contact & Devis Rapide
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0C2340] tracking-tight">
            Prêt à Concrétiser Votre Projet avec AYEGROUPE ?
          </h2>
          <p class="text-[#2C3E50] text-sm sm:text-base leading-relaxed">
            Que vous ayez besoin d'une équipe de développement logiciel remote, de fournitures pour vos bureaux à Lomé ou d'une solution de transport logistique, nous mettons notre expertise à votre service.
          </p>

          <div class="space-y-3.5 pt-2">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-[#00A859] flex items-center justify-center font-bold text-xs flex-shrink-0">
                IT
              </div>
              <div>
                <h4 class="text-sm font-bold text-[#0C2340]">Ingénierie & Consulting International</h4>
                <p class="text-xs text-slate-500 mt-0.5">Accompagnement agile, architecture web & SaaS sur mesure.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 text-[#0284C7] flex items-center justify-center font-bold text-xs flex-shrink-0">
                TG
              </div>
              <div>
                <h4 class="text-sm font-bold text-[#0C2340]">Opérations & Logistique Togo</h4>
                <p class="text-xs text-slate-500 mt-0.5">Approvisionnement matériel, maintenance et gestion de flotte.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm lang="fr" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
