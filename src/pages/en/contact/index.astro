---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/ContactForm.astro';
---

<BaseLayout
  title="Contact AYEGROUPE — Inquiries, Quotes & Consultations"
  description="Connect with AYEGROUPE for software engineering consultations, custom SaaS design, or regional trade and logistics solutions in Togo."
  lang="en"
  canonicalPath="/en/contact"
>
  <section class="bg-gradient-to-b from-[#F4F6F9] via-white to-white py-16 lg:py-20 text-[#0C2340] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl space-y-4">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200 font-mono">
          Responsiveness & Clarity
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#0C2340]">
          Let's Start the Conversation
        </h1>
        <p class="text-[#2C3E50] text-base sm:text-lg font-normal">
          Our senior software architects and trade operators are ready to evaluate your requirements and provide a transparent quotation within 24 hours.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <div class="lg:col-span-5 space-y-8">
          
          <div class="rounded-2xl bg-white border border-slate-200 p-8 shadow-sm space-y-6">
            <h3 class="text-xl font-bold text-[#0C2340]">Direct Channels</h3>
            
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-full bg-emerald-50 border border-emerald-200 text-[#00A859] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.067-1.118-.067-.323-.102-.734-.239-1.266-.469-2.228-.962-3.682-3.23-3.794-3.379-.111-.148-.908-1.206-.908-2.302 0-1.096.575-1.636.78-1.859.183-.2.433-.277.674-.277.081 0 .153.004.218.008.192.008.318.038.459.378.175.422.597 1.455.65 1.562.053.107.088.232.018.373-.07.142-.105.231-.21.353-.105.123-.22.274-.314.368-.105.105-.215.22-.092.43.123.211.547.902 1.174 1.46 1.066.949 1.939 1.258 2.213 1.394.275.137.436.115.597-.07.162-.185.69-.803.874-1.079.183-.276.368-.231.614-.14.246.091 1.559.734 1.825.867.266.133.444.198.508.307.065.108.065.632-.079 1.037z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Direct WhatsApp</span>
                <a
                  href="https://wa.me/22890000000"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-bold text-[#00A859] hover:underline"
                >
                  +228 90 00 00 00 (Lomé, Togo)
                </a>
                <p class="text-xs text-slate-500 mt-0.5">Real-time response during regional business hours.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-full bg-slate-100 border border-slate-200 text-[#0C2340] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Official Email</span>
                <a href="mailto:ayegroupe@ayegroupe.com" class="text-sm font-bold text-[#0C2340] hover:text-[#00A859]">
                  ayegroupe@ayegroupe.com
                </a>
                <p class="text-xs text-slate-500 mt-0.5">For enterprise RFPs, partnership proposals, and quotes.</p>
              </div>
            </div>

            <!-- Corporate HQ: Surrey, Canada -->
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-full bg-slate-100 border border-slate-200 text-[#0C2340] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Company Headquarters</span>
                <span class="text-sm font-bold text-[#0C2340]">Surrey, British Columbia, Canada</span>
                <p class="text-xs text-slate-500 mt-0.5">Technology leadership, software engineering & global governance.</p>
              </div>
            </div>

            <!-- Regional Hub: Lomé, Togo -->
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-full bg-slate-100 border border-slate-200 text-[#0C2340] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">West Africa Regional Hub</span>
                <span class="text-sm font-bold text-[#0C2340]">Lomé, Republic of Togo</span>
                <p class="text-xs text-slate-500 mt-0.5">Physical freight logistics, hardware dispatch, and in-person consultations.</p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-[#F4F6F9] border border-slate-200 text-[#0C2340] space-y-3">
            <h4 class="text-xs font-bold text-[#00A859] uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#00A859]"></span>
              Operating Schedules
            </h4>
            <p class="text-xs text-[#2C3E50] leading-relaxed">
              • <strong>Togo Ground Operations</strong> : Monday to Friday, 08:00 &ndash; 18:00 GMT.<br/>
              • <strong>Global IT & Cloud Support</strong> : Continuous 24/7 telemetry and emergency escalation.
            </p>
          </div>

        </div>

        <div class="lg:col-span-7">
          <ContactForm lang="en" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
