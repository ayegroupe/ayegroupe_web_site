---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const divisions = [
  {
    id: 'it-bureautique',
    letter: 'A',
    title: 'IT & Office Hardware Procurement',
    subtitle: 'Enterprise IT infrastructure, ergonomic furniture & LAN cabling',
    description: 'Turnkey provision, certified installation, and operational maintenance of computer hardware, workstations, printers, and structured networks for banks, corporations, and administrations in Lomé.',
    items: [
      'Workstations, enterprise laptops, servers, and multi-function printers',
      'Original toner supplies, peripherals, and executive office furniture',
      'Structured Cat6/Cat7 network cabling, server racks, and high-density Wi-Fi',
      'Business continuity, cloud migration, and managed IT services',
    ],
  },
  {
    id: 'logistique',
    letter: 'B',
    title: 'Logistics, Warehousing & Fleet Mobility',
    subtitle: 'Freight forwarding, modern storage, and executive vehicle leasing',
    description: 'Comprehensive supply chain services: from secured container transport between the Port of Lomé and regional warehouses, to commercial fleet leasing and driver services.',
    items: [
      'Multi-modal freight forwarding (Port of Lomé, airport, customer sites)',
      'Secure, 24/7 guarded warehousing and digitized inventory control (FIFO)',
      'High-velocity order fulfillment, picking, packing, and distribution',
      'Corporate 4x4, utility vans, and executive sedan rental with or without drivers',
    ],
  },
  {
    id: 'import-export',
    letter: 'C',
    title: 'General Trade & Import / Export',
    subtitle: 'Global commodity sourcing, multimodal transit, and customs facilitation',
    description: 'Your reliable trading gateway connecting international verified suppliers to the Togolese and broader ECOWAS regional market with full regulatory compliance.',
    items: [
      'General merchandise import/export across worldwide supply corridors',
      'Supplier factory vetting, price negotiation, and pre-shipment inspection',
      'Customs clearance advisory and single-window (GUCE) documentation handling',
      'End-to-end maritime (FCL/LCL) and air cargo shipment tracking',
    ],
  },
];
---

<BaseLayout
  title="Togo Hub — General Trade, IT Supply & Logistics"
  description="AYEGROUPE operational hub in Togo: Import/Export, office equipment and computer hardware, freight transport, warehousing, and corporate vehicle fleet rentals in Lomé."
  lang="en"
  canonicalPath="/en/togo"
>
  <!-- Hero Section Togo -->
  <section class="bg-gradient-to-b from-[#F4F6F9] via-white to-white py-16 lg:py-24 text-[#0C2340] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200 font-mono">
            Operational Presence · Lomé, Togo
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0C2340]">
            General Trade, IT Supply & Logistics in Togo
          </h1>
          <p class="text-base sm:text-lg text-[#2C3E50] leading-relaxed font-normal">
            AYEGROUPE is your trusted execution partner in Lomé and the West African economic corridor for commercial procurement, certified IT supply, and resilient logistics management.
          </p>
          
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="https://wa.me/17788091060?text=Hello%20AYEGROUPE%2C%20I%20would%20like%20to%20request%20a%20quote%20for%20Togo%20Operations"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3.5 rounded-full bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs uppercase tracking-wider shadow-sm hover:shadow-md transition-all duration-150 inline-flex items-center gap-2 hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>WhatsApp Lomé Direct</span>
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.067-1.118-.067-.323-.102-.734-.239-1.266-.469-2.228-.962-3.682-3.23-3.794-3.379-.111-.148-.908-1.206-.908-2.302 0-1.096.575-1.636.78-1.859.183-.2.433-.277.674-.277.081 0 .153.004.218.008.192.008.318.038.459.378.175.422.597 1.455.65 1.562.053.107.088.232.018.373-.07.142-.105.231-.21.353-.105.123-.22.274-.314.368-.105.105-.215.22-.092.43.123.211.547.902 1.174 1.46 1.066.949 1.939 1.258 2.213 1.394.275.137.436.115.597-.07.162-.185.69-.803.874-1.079.183-.276.368-.231.614-.14.246.091 1.559.734 1.825.867.266.133.444.198.508.307.065.108.065.632-.079 1.037z"/>
              </svg>
            </a>
            <a
              href="/en/contact"
              class="px-8 py-3 rounded-full bg-white hover:bg-[#0C2340] text-[#0C2340] hover:text-white font-bold text-xs uppercase tracking-wider border-2 border-[#0C2340] transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
            >
              Request Local Quotation
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-white group">
            <img
              src="/images/togo/port-lome-logistics.webp"
              alt="Autonomous Port of Lomé Maritime and Logistics Hub AYEGROUPE"
              class="w-full h-80 sm:h-96 object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#0C2340]/90 backdrop-blur-md border border-white/10 text-white flex items-center justify-between">
              <div>
                <span class="block text-xs font-bold text-emerald-400 font-mono uppercase tracking-wider">Port of Lomé</span>
                <span class="text-sm font-semibold">West Africa Logistics Gateway</span>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold">
                Deep Water
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {divisions.map((div) => (
        <div class="rounded-2xl bg-white border border-slate-200 p-8 lg:p-10 shadow-xs hover:border-[#00A859]/50 hover:shadow-md transition-all duration-200">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-7 space-y-4">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-[#E6F7EF] border border-[#00A859]/30 text-[#00A859] font-mono font-bold flex items-center justify-center text-xs">
                  {div.letter}
                </span>
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider font-mono">
                  Operational Division
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0C2340] tracking-tight">
                {div.title}
              </h2>
              <p class="text-[#00A859] font-bold text-xs sm:text-sm uppercase tracking-wide">
                {div.subtitle}
              </p>
              <p class="text-[#2C3E50] text-xs sm:text-sm leading-relaxed">
                {div.description}
              </p>

              <ul class="space-y-2.5 pt-2">
                {div.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-700">
                    <svg class="w-4 h-4 text-[#00A859] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="font-medium">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="lg:col-span-5 flex flex-col justify-center items-center lg:items-end p-6 rounded-2xl bg-slate-50 border border-slate-200 text-center lg:text-right space-y-4">
              <span class="text-xs text-slate-500 font-semibold">Immediate availability in Lomé and nationwide</span>
              <a
                href="/en/contact"
                class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs uppercase tracking-wider shadow-sm hover:shadow-md transition-all duration-150 hover:-translate-y-0.5"
              >
                <span>Request Quotation</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
