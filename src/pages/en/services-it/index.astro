---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalAccordion from '../../../components/LegalAccordion.astro';

const categories = [
  {
    number: '01',
    title: 'Custom Software & Application Development',
    badge: 'Core Expertise',
    summary: 'Bespoke design and engineering of enterprise web, mobile, and distributed applications tailored to your proprietary business workflows.',
    items: [
      'Custom application & software programming',
      'Scalable backend architectures (RESTful APIs, GraphQL, microservices)',
      'Responsive, high-performance frontends (React, Next.js, Astro)',
      'Systems analysis and comprehensive software architecture design',
    ],
  },
  {
    number: '02',
    title: 'IT Consulting & Enterprise Architecture',
    badge: 'Strategy',
    summary: 'Strategic technology advisory, infrastructure roadmap alignment, technical auditing, and IT investment optimization.',
    items: [
      'Hardware and software architecture consulting',
      'System performance, scalability, and security audits',
      'Enterprise requirements and feasibility analysis',
      'IT master planning and modernization blueprints',
    ],
  },
  {
    number: '03',
    title: 'Systems Design & Integration',
    badge: 'Interoperability',
    summary: 'Unifying fragmented corporate data pipelines, interconnecting business tools, and redesigning legacy information systems.',
    items: [
      'Computer systems design & systems engineering',
      'Management Information Systems (MIS) integration',
      'Office automation and enterprise process engineering',
      'Third-party API orchestrations and cross-platform synchronization',
    ],
  },
  {
    number: '04',
    title: 'Networks & Infrastructure Engineering',
    badge: 'Connectivity',
    summary: 'Engineering high-availability local and wide-area networks, securing communications, and administering corporate infrastructure.',
    items: [
      'Local Area Network (LAN) design, cabling, and deployment',
      'Managed switches, firewalls, and enterprise VPN tunnels',
      'Proactive bandwidth monitoring, failover, and fault tolerance',
      'Distributed systems administration and cloud hybrid setups',
    ],
  },
  {
    number: '05',
    title: 'CAD / CAM / CAE Technical Solutions',
    badge: 'Industry & CAD',
    summary: 'Specialized computing infrastructure and software environments for Computer-Aided Design, Manufacturing, and Engineering.',
    items: [
      'CAD infrastructure deployment and workstation optimization',
      'CAM software environment configuration and technical support',
      'CAE simulation compute power sizing and performance tuning',
      'Workstation cluster deployment for architectural and 3D modeling',
    ],
  },
  {
    number: '06',
    title: 'Operations, Maintenance & Disaster Recovery',
    badge: 'High Availability',
    summary: 'Proactive 24/7 technical monitoring, managed facility support, and business continuity protocols to ensure zero downtime.',
    items: [
      'Preventive and corrective IT hardware/software maintenance',
      'Computer facilities management and outsourced sysadmin operations',
      'Disaster recovery planning and automated cloud backups',
      'Data processing facility security and uptime optimization',
    ],
  },
  {
    number: '07',
    title: 'Web Platforms & Application Suites',
    badge: 'Digitalization',
    summary: 'Designing high-converting web portals, internal tools, and deploying turnkey software suites into client IT ecosystems.',
    items: [
      'High-performance corporate websites and digital portals',
      'Installation, configuration, and tuning of enterprise software suites',
      'Seamless integration of multi-vendor applications into existing IT',
      'Staff training, technical handover, and ongoing documentation',
    ],
  },
  {
    number: '08',
    title: 'Monetized SaaS Engineering',
    badge: 'Product & SaaS',
    summary: 'From concept to scalable profitability: architecting end-to-end SaaS platforms with subscription billing, payments, and AI.',
    items: [
      'Multi-tenant SaaS architectures and recurring subscription engines',
      'Global payment gateways (Stripe, FedaPay Mobile Money, PayPal)',
      'AI pipeline integration (OpenAI GPT-4o, Whisper audio models)',
      'Real-world proof of competence: our live platforms AyePrep and AyeJob',
    ],
  },
];
---

<BaseLayout
  title="International IT & Software Engineering Hub | AYEGROUPE"
  description="Bespoke software development, IT consulting, systems integration, cloud infrastructure, and proprietary SaaS platforms by AYEGROUPE."
  lang="en"
  canonicalPath="/en/services-it"
>
  <section class="bg-gradient-to-b from-[#F4F6F9] via-white to-white py-16 lg:py-24 text-[#0C2340] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200 font-mono">
            Global Operations · Surrey, Canada
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0C2340]">
            Software Engineering & IT Advisory
          </h1>
          <p class="text-base sm:text-lg text-[#2C3E50] leading-relaxed font-normal">
            AYEGROUPE brings senior engineering discipline and modern architectural standards to solve your most complex digital challenges. Explore our 8 structured domains of technical competence.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="/en/contact"
              class="px-8 py-3.5 rounded-full bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs uppercase tracking-wider shadow-sm hover:shadow-md transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
            >
              Discuss Your Project
            </a>
            <a
              href="/en/saas"
              class="px-8 py-3 rounded-full bg-white hover:bg-[#0C2340] text-[#0C2340] hover:text-white font-bold text-xs uppercase tracking-wider border-2 border-[#0C2340] transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
            >
              Explore Live SaaS &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-white group">
            <img
              src="/images/it/cloud-engineering-office.webp"
              alt="AYEGROUPE software engineering and cloud architecture team"
              class="w-full h-80 sm:h-96 object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#0C2340]/90 backdrop-blur-md border border-white/10 text-white flex items-center justify-between">
              <div>
                <span class="block text-xs font-bold text-emerald-400 font-mono uppercase tracking-wider">IT Center of Excellence</span>
                <span class="text-sm font-semibold">Surrey, British Columbia</span>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold">
                99.9% SLA
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {categories.map((cat) => (
          <div class="rounded-2xl bg-white border border-slate-200 p-8 shadow-xs hover:border-[#00A859]/50 hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="font-mono text-2xl font-bold text-[#00A859] group-hover:text-[#008F4C] transition-colors">
                  {cat.number}
                </span>
                <span class="px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-[#0C2340] border border-slate-200 font-mono">
                  {cat.badge}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-[#0C2340] mb-2 group-hover:text-[#00A859] transition-colors">
                {cat.title}
              </h3>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-6">
                {cat.summary}
              </p>

              <ul class="space-y-2.5 mb-8 border-t border-slate-100 pt-6">
                {cat.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-700">
                    <svg class="w-4 h-4 text-[#00A859] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="font-medium">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/en/contact?subject=${encodeURIComponent(cat.title)}`}
                class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#00A859] hover:text-[#008F4C] transition-colors"
              >
                <span>Request service quotation</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50/70 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-4">
        <h2 class="text-2xl font-bold text-slate-900">Full Legal Nomenclature</h2>
        <p class="text-slate-600 text-xs sm:text-sm mt-1">Official compliance and certification covering the 38 registered activities of AYEGROUPE.</p>
      </div>
      <LegalAccordion lang="en" />
    </div>
  </section>
</BaseLayout>
