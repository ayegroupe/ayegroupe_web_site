---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalAccordion from '../../../components/LegalAccordion.astro';

const categories = [
  {
    number: '01',
    title: 'Custom Software Development',
    badge: 'Core Expertise',
    summary: 'Tailored architecture, engineering, and programming of web, mobile, and enterprise software designed specifically around your proprietary workflows.',
    items: [
      'Custom application & software programming services',
      'High-throughput backend development (REST, GraphQL, microservices)',
      'Responsive, accessible modern frontends (React, Next.js, Astro)',
      'Systems analysis and foundational software design',
    ],
  },
  {
    number: '02',
    title: 'IT Consulting & Systems Audit',
    badge: 'Strategy',
    summary: 'Strategic technology advisory, comprehensive code and architecture audits, and technology spend rationalization.',
    items: [
      'Computer hardware and software consulting services',
      'Performance, security, and scalability application audits',
      'Technical requirements analysis and specification design',
      'Enterprise IT master plan formulation',
    ],
  },
  {
    number: '03',
    title: 'Systems Design & Integration',
    badge: 'Interoperability',
    summary: 'Unified data pipelines, legacy modernization, and seamless enterprise system integration for SMEs and global operations.',
    items: [
      'Computer systems design, analysis & systems engineering',
      'Management Information Systems (MIS) design and integration',
      'Advanced office automation and business process workflows',
      'Third-party API aggregation and distributed database synchronization',
    ],
  },
  {
    number: '04',
    title: 'Networks & Cloud Infrastructure',
    badge: 'Connectivity',
    summary: 'Local and distributed network design, secure site-to-site tunnels, and automated cloud infrastructure provisioning.',
    items: [
      'Local Area Network (LAN) design, cabling & integration',
      'Managed switches, firewalls, and enterprise VPN tunnels',
      'Proactive bandwidth monitoring and failover redundancy',
      'Distributed systems administration and cloud security posture',
    ],
  },
  {
    number: '05',
    title: 'CAD / CAM / CAE Solutions',
    badge: 'Engineering',
    summary: 'Specialized computer services for engineering workstations, technical modeling, simulation, and industrial design tools.',
    items: [
      'Computer-Aided Design (CAD) systems configuration & services',
      'Computer-Aided Manufacturing (CAM) integration',
      'Computer-Aided Engineering (CAE) compute infrastructure support',
      'High-performance workstation provisioning and GPU rendering nodes',
    ],
  },
  {
    number: '06',
    title: 'Operations, Maintenance & Continuity',
    badge: 'High Availability',
    summary: 'Continuous systems supervision, facilities management, and disaster recovery architectures ensuring near-zero unplanned downtime.',
    items: [
      'Preventive and corrective IT system maintenance',
      'Computer facilities management and distributed cloud operations',
      'Disaster Recovery (DR) and business continuity planning',
      'Data processing facilities management and enterprise backup audits',
    ],
  },
  {
    number: '07',
    title: 'Web & Enterprise Applications',
    badge: 'Digitalization',
    summary: 'Creation of high-speed corporate web portals, portals, and turn-key deployment of specialized business software suites.',
    items: [
      'High-speed corporate web platforms and web application development',
      'Installation and turnkey configuration of enterprise software',
      'Multi-software environment integration into existing client IT stacks',
      'Team training and comprehensive technical documentation',
    ],
  },
  {
    number: '08',
    title: 'Monetized SaaS Engineering',
    badge: 'Product & Scaling',
    summary: 'From concept to recurring revenue: we architect, build, and deploy full-lifecycle SaaS platforms with global billing and AI integrations.',
    items: [
      'Multi-tenant SaaS architectures and automated subscription billing',
      'Global payment gateways (Stripe, FedaPay Mobile Money, PayPal)',
      'Artificial Intelligence integration (OpenAI GPT-4o, Whisper voice)',
      'Real-world proof: our own live platforms AyePrep and AyeJob',
    ],
  },
];
---

<BaseLayout
  title="Global IT & Software Engineering Hub"
  description="Bespoke software development, IT consulting, systems integration, cloud architecture, and monetized SaaS engineering by AYEGROUPE."
  lang="en"
  canonicalPath="/en/services-it"
>
  <section class="bg-brand-navy py-16 lg:py-24 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-blue/20 text-brand-blue-light border border-brand-blue/30 font-mono">
          Global Operations · Remote & Advisory
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Software Engineering & IT Advisory
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          AYEGROUPE brings senior engineering discipline and modern architectural standards to solve your most complex digital challenges. Explore our 8 structured domains of technical competence.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/en/contact"
            class="px-8 py-3.5 rounded-xl bg-brand-blue hover:bg-brand-blue-dark text-white font-bold text-sm shadow-xl shadow-brand-blue/30 transition-all duration-200"
          >
            Discuss Your Project
          </a>
          <a
            href="/en/saas"
            class="px-8 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/20 transition-all duration-200"
          >
            Explore Live SaaS &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {categories.map((cat) => (
          <div class="rounded-3xl bg-white border border-slate-200/80 p-8 shadow-sm hover:shadow-card-hover hover:border-brand-blue/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="font-mono text-2xl font-black text-brand-blue/30 group-hover:text-brand-blue transition-colors">
                  {cat.number}
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-brand-blue border border-blue-100 font-mono">
                  {cat.badge}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-brand-navy mb-3 group-hover:text-brand-blue transition-colors">
                {cat.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {cat.summary}
              </p>

              <ul class="space-y-2.5 mb-8 border-t border-slate-100 pt-6">
                {cat.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
                    <svg class="w-4 h-4 text-brand-blue flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/en/contact?subject=${encodeURIComponent(cat.title)}`}
                class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-brand-blue hover:text-brand-blue-dark transition-colors"
              >
                <span>Request a quote for this service</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-navy text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-4">
        <h2 class="text-2xl font-bold text-white">Official Legal Registry</h2>
        <p class="text-slate-400 text-sm mt-1">Full statutory nomenclature of all 38 declared business activities for AYEGROUPE.</p>
      </div>
      <LegalAccordion lang="en" />
    </div>
  </section>
</BaseLayout>
