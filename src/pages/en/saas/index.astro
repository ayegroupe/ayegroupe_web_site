---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SaasShowcase from '../../../components/SaasShowcase.astro';
---

<BaseLayout
  title="Our Live SaaS Solutions in Production | AYEGROUPE"
  description="Discover proprietary software platforms designed and scaled by AYEGROUPE: AyePrep (EdTech) and AyeJob (Recruitment)."
  lang="en"
  canonicalPath="/en/saas"
>
  <section class="bg-brand-navy py-16 lg:py-24 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-mono">
          Proprietary & Monetized Software
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Our Live SaaS Platforms
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          AYEGROUPE architects, runs, and monetizes its own tech products. Serving thousands of active users daily, these applications prove our ability to deliver world-class software engineering.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SaasShowcase lang="en" showCta={true} />
    </div>
  </section>

  <section class="py-16 bg-slate-900 text-white border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
        <span class="text-xs font-mono font-bold text-brand-blue-light uppercase tracking-widest">
          Robust Tech Architecture
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white">
          The Engineering Engine Powering Our Products
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">
          Proven modern choices delivering 99.9% uptime, near-zero latency, and enterprise-grade data security.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-brand-blue-light mb-1">AI & LLM</div>
          <div class="text-xs text-slate-400">OpenAI GPT-4o & Whisper voice</div>
        </div>
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-emerald-400 mb-1">Global Pay</div>
          <div class="text-xs text-slate-400">Stripe & FedaPay Mobile Money</div>
        </div>
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-brand-gold mb-1">Cloud Edge</div>
          <div class="text-xs text-slate-400">Supabase, Vercel & Cloudflare</div>
        </div>
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
          <div class="text-2xl font-black text-purple-400 mb-1">Multi-Platform</div>
          <div class="text-xs text-slate-400">React PWA & Flutter Mobile</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
