---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SaasShowcase from '../../../components/SaasShowcase.astro';
---

<BaseLayout
  title="Our Live SaaS Solutions in Production | AYEGROUPE"
  description="Discover proprietary software platforms designed and scaled by AYEGROUPE: AyePrep (EdTech) and AyeJob (Recruitment)."
  lang="en"
  canonicalPath="/en/saas"
>
  <section class="bg-gradient-to-b from-[#F4F6F9] via-white to-white py-16 lg:py-24 text-[#0C2340] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200 font-mono">
          Proprietary & Monetized Software
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0C2340]">
          Our Live SaaS Platforms
        </h1>
        <p class="text-base sm:text-lg text-[#2C3E50] leading-relaxed font-normal">
          AYEGROUPE architects, runs, and monetizes its own tech products. Serving thousands of active users daily, these applications prove our ability to deliver world-class software engineering.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SaasShowcase lang="en" showCta={true} />
    </div>
  </section>

  <section class="py-16 bg-[#F4F6F9] text-[#0C2340]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-3.5 mb-12">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-[#0C2340] border border-slate-200 font-mono">
          Robust Tech Architecture
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#0C2340] tracking-tight">
          The Engineering Engine Powering Our Products
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Proven modern choices delivering 99.9% uptime, near-zero latency, and enterprise-grade data security.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-[#00A859]/50 shadow-xs transition-colors">
          <div class="text-xl sm:text-2xl font-bold font-mono text-[#00A859] mb-1">AI & LLM</div>
          <div class="text-xs text-slate-600 font-medium">OpenAI GPT-4o & Whisper voice</div>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-[#00A859]/50 shadow-xs transition-colors">
          <div class="text-xl sm:text-2xl font-bold font-mono text-[#00A859] mb-1">Global Pay</div>
          <div class="text-xs text-slate-600 font-medium">Stripe & FedaPay Mobile Money</div>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-[#00A859]/50 shadow-xs transition-colors">
          <div class="text-xl sm:text-2xl font-bold font-mono text-[#0C2340] mb-1">Cloud Edge</div>
          <div class="text-xs text-slate-600 font-medium">Supabase, Vercel & Cloudflare</div>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-[#00A859]/50 shadow-xs transition-colors">
          <div class="text-xl sm:text-2xl font-bold font-mono text-[#0C2340] mb-1">Multi-Support</div>
          <div class="text-xs text-slate-600 font-medium">React PWA & Flutter Mobile</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
