---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoleSelector from '../../components/PoleSelector.astro';
import SaasShowcase from '../../components/SaasShowcase.astro';
import ContactForm from '../../components/ContactForm.astro';
import LegalAccordion from '../../components/LegalAccordion.astro';
import CreativeServicesSlide from '../../components/CreativeServicesSlide.astro';
import PlacesJourney from '../../components/PlacesJourney.astro';

const metrics = [
  { value: '02', label: 'Centers of Excellence', sub: 'Global IT & Togo Regional Hub' },
  { value: '02', label: 'Live SaaS Products', sub: 'AyePrep & AyeJob' },
  { value: '38', label: 'Areas of Expertise', sub: 'IT, trade & logistics' },
  { value: '24/7', label: 'Support & Availability', sub: 'Lomé & Global Remote' },
];
---

<BaseLayout
  title="Software Engineering, Trade & Regional Logistics"
  description="AYEGROUPE combines cutting-edge international software engineering with regional trade and logistics excellence in Togo."
  lang="en"
  canonicalPath="/en"
>
  <!-- Visite des lieux : chaque lieu est une activité du groupe -->
  <PlacesJourney lang="en" />

  <!-- Chiffres clés -->
  <section class="bg-[#07172B] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6 sm:gap-6">
        {metrics.map((m) => (
          <div class="border-l-2 border-[#F59E0B] pl-3 sm:pl-4">
            <div class="text-2xl sm:text-4xl font-bold font-mono text-white tracking-tight">{m.value}</div>
            <div class="mt-1 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-white">{m.label}</div>
            <div class="text-[11px] sm:text-xs text-slate-400 font-medium mt-0.5">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section Divisions -->
  <section class="py-20 lg:py-28 bg-white relative border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3.5">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-[#0C2340] border border-slate-200">
          Group Architecture
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0C2340] tracking-tight">
          Two Distinct Markets, One Standard of Excellence
        </h2>
        <p class="text-[#2C3E50] text-base sm:text-lg leading-relaxed">
          Tailored communication and execution models to address the precise demands of global tech partners and West African trade operations.
        </p>
      </div>

      <PoleSelector lang="en" />

    </div>
  </section>

  <!-- Section Creative Studio (Websites, Logos, Flyers) -->
  <CreativeServicesSlide lang="en" />

  <!-- Section SaaS Showcase -->
  <section class="py-20 lg:py-28 bg-[#F4F6F9] relative overflow-hidden border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-sky opacity-20 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3.5">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200">
          Engineering Track Record
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0C2340] tracking-tight">
          Our Proprietary SaaS in Production
        </h2>
        <p class="text-[#2C3E50] text-base sm:text-lg leading-relaxed">
          We don't just build software for clients: we engineer, scale, and monetize our own high-traffic digital platforms.
        </p>
      </div>

      <SaasShowcase lang="en" showCta={true} />
    </div>
  </section>

  <!-- Section Legal & Declared activities -->
  <section class="py-16 lg:py-24 bg-white text-[#0C2340] relative border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0C2340] tracking-tight">
          Transparency & Legal Framework
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Review the full statutory register of 38 authorized software engineering, trade, and logistics activities.
        </p>
      </div>

      <LegalAccordion lang="en" />
    </div>
  </section>

  <!-- Quick Contact Section -->
  <section class="py-20 lg:py-28 bg-[#F4F6F9] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="inline-flex items-center px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-[#00A859] border border-emerald-200">
            Contact & Fast Quotations
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0C2340] tracking-tight">
            Ready to Accelerate Your Operations?
          </h2>
          <p class="text-[#2C3E50] text-sm sm:text-base leading-relaxed">
            Whether you need a dedicated software engineering squad, IT equipment delivery in Lomé, or regional freight transport, AYEGROUPE is your trusted execution partner.
          </p>

          <div class="space-y-3.5 pt-2">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-[#00A859] flex items-center justify-center font-bold text-xs flex-shrink-0">
                IT
              </div>
              <div>
                <h4 class="text-sm font-bold text-[#0C2340]">Global Engineering & Consulting</h4>
                <p class="text-xs text-slate-500 mt-0.5">Agile delivery, enterprise cloud systems & custom SaaS.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 text-[#0284C7] flex items-center justify-center font-bold text-xs flex-shrink-0">
                TG
              </div>
              <div>
                <h4 class="text-sm font-bold text-[#0C2340]">Togo Ground Operations & Logistics</h4>
                <p class="text-xs text-slate-500 mt-0.5">Hardware procurement, maintenance, warehousing & vehicle leasing.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm lang="en" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
