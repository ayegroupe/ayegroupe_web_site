---
interface Props {
  lang?: 'fr' | 'en';
  phone?: string;
}

const { lang = 'fr', phone = '+22890000000' } = Astro.props;

const message = lang === 'fr' 
  ? encodeURIComponent("Bonjour AYEGROUPE, j'aimerais échanger avec vous concernant vos prestations et obtenir un devis.")
  : encodeURIComponent("Hello AYEGROUPE, I would like to inquire about your services and get a quote.");

const whatsappUrl = `https://wa.me/${phone.replace(/[^0-9]/g, '')}?text=${message}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-3 rounded-full shadow-2xl hover:shadow-emerald-500/40 transition-all duration-300 transform hover:-translate-y-1 group"
  aria-label={lang === 'fr' ? "Discuter sur WhatsApp avec AYEGROUPE" : "Chat on WhatsApp with AYEGROUPE"}
>
  <span class="relative flex h-3.5 w-3.5">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-white"></span>
  </span>

  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.067-1.118-.067-.323-.102-.734-.239-1.266-.469-2.228-.962-3.682-3.23-3.794-3.379-.111-.148-.908-1.206-.908-2.302 0-1.096.575-1.636.78-1.859.183-.2.433-.277.674-.277.081 0 .153.004.218.008.192.008.318.038.459.378.175.422.597 1.455.65 1.562.053.107.088.232.018.373-.07.142-.105.231-.21.353-.105.123-.22.274-.314.368-.105.105-.215.22-.092.43.123.211.547.902 1.174 1.46 1.066.949 1.939 1.258 2.213 1.394.275.137.436.115.597-.07.162-.185.69-.803.874-1.079.183-.276.368-.231.614-.14.246.091 1.559.734 1.825.867.266.133.444.198.508.307.065.108.065.632-.079 1.037z"/>
  </svg>

  <span class="text-sm font-bold tracking-wide hidden sm:inline">
    {lang === 'fr' ? 'WhatsApp Direct' : 'Direct WhatsApp'}
  </span>
</a>
