---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const labels = {
  fr: {
    title: 'Transmettez-nous votre demande',
    subtitle: 'Nos experts vous répondent sous 24 heures ouvrées.',
    name: 'Nom complet ou Raison sociale *',
    email: 'Adresse email professionnelle *',
    phone: 'Numéro de téléphone / WhatsApp',
    pole: 'Pôle d\'activité concerné *',
    selectPole: 'Sélectionnez un pôle',
    poleIt: 'Pôle IT & Ingénierie logicielle (International)',
    poleTogo: 'Pôle Togo (Fourniture IT, Matériel, Logistique)',
    poleSaas: 'Solutions SaaS & Création de plateforme',
    poleOther: 'Autre demande / Partenariat',
    message: 'Détail de votre besoin ou projet *',
    placeholderMsg: 'Précisez vos objectifs, délais et contraintes...',
    submit: 'Envoyer ma demande',
    sending: 'Envoi en cours...',
    success: 'Merci ! Votre message a été transmis avec succès. Nous reviendrons vers vous très rapidement.',
    error: "Une erreur est survenue lors de l'envoi. Merci de réessayer ou de nous contacter par WhatsApp.",
    directOr: 'Ou contactez directement nos équipes :',
  },
  en: {
    title: 'Send us your inquiry',
    subtitle: 'Our specialists will get back to you within 24 business hours.',
    name: 'Full Name or Company *',
    email: 'Professional Email Address *',
    phone: 'Phone / WhatsApp Number',
    pole: 'Division Concerned *',
    selectPole: 'Select a business unit',
    poleIt: 'IT & Software Engineering (International)',
    poleTogo: 'Togo Hub (IT Supply, Hardware, Logistics)',
    poleSaas: 'SaaS Solutions & Custom Platforms',
    poleOther: 'Other inquiry / Strategic partnership',
    message: 'Project details or inquiry *',
    placeholderMsg: 'Describe your goals, timeline, and expectations...',
    submit: 'Submit Inquiry',
    sending: 'Submitting...',
    success: 'Thank you! Your message has been sent successfully. We will follow up with you promptly.',
    error: 'Something went wrong while sending your message. Please try again or reach us on WhatsApp.',
    directOr: 'Or connect directly with our regional teams:',
  }
};

const l = labels[lang];
---

<div class="rounded-2xl bg-white border border-slate-200 p-8 sm:p-10 shadow-sm">
  <div class="mb-8">
    <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0C2340] tracking-tight">
      {l.title}
    </h3>
    <p class="text-[#2C3E50] text-sm mt-1.5 leading-relaxed">
      {l.subtitle}
    </p>
  </div>

  <form id="ayegroupe-contact-form" class="space-y-5" data-lang={lang}>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Name -->
      <div>
        <label for="contact-name" class="block text-[11px] font-bold text-[#0C2340] uppercase tracking-wider mb-2">
          {l.name}
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          class="w-full px-4 py-3 rounded-lg bg-white border border-slate-300 text-[#0C2340] placeholder-slate-400 focus:outline-none focus:border-[#00A859] focus:ring-2 focus:ring-[#00A859]/20 transition-all text-xs"
          placeholder="Ex: Koffi Mensah / Entreprise SARL"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="contact-email" class="block text-[11px] font-bold text-[#0C2340] uppercase tracking-wider mb-2">
          {l.email}
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-lg bg-white border border-slate-300 text-[#0C2340] placeholder-slate-400 focus:outline-none focus:border-[#00A859] focus:ring-2 focus:ring-[#00A859]/20 transition-all text-xs"
          placeholder="contact@votre-entreprise.com"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Phone / WhatsApp -->
      <div>
        <label for="contact-phone" class="block text-[11px] font-bold text-[#0C2340] uppercase tracking-wider mb-2">
          {l.phone}
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          class="w-full px-4 py-3 rounded-lg bg-white border border-slate-300 text-[#0C2340] placeholder-slate-400 focus:outline-none focus:border-[#00A859] focus:ring-2 focus:ring-[#00A859]/20 transition-all text-xs"
          placeholder="+228 90 00 00 00"
        />
      </div>

      <!-- Pole Division Selector -->
      <div>
        <label for="contact-pole" class="block text-[11px] font-bold text-[#0C2340] uppercase tracking-wider mb-2">
          {l.pole}
        </label>
        <select
          id="contact-pole"
          name="pole"
          required
          class="w-full px-4 py-3 rounded-lg bg-white border border-slate-300 text-[#0C2340] focus:outline-none focus:border-[#00A859] focus:ring-2 focus:ring-[#00A859]/20 transition-all text-xs"
        >
          <option value="" disabled selected>{l.selectPole}</option>
          <option value="it">{l.poleIt}</option>
          <option value="togo">{l.poleTogo}</option>
          <option value="saas">{l.poleSaas}</option>
          <option value="other">{l.poleOther}</option>
        </select>
      </div>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-[11px] font-bold text-[#0C2340] uppercase tracking-wider mb-2">
        {l.message}
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        class="w-full px-4 py-3 rounded-lg bg-white border border-slate-300 text-[#0C2340] placeholder-slate-400 focus:outline-none focus:border-[#00A859] focus:ring-2 focus:ring-[#00A859]/20 transition-all text-xs resize-y"
        placeholder={l.placeholderMsg}
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs uppercase tracking-wider shadow-sm hover:shadow-md transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>{l.submit}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
    </div>

    <!-- Feedback Message Box -->
    <div id="contact-feedback-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-[#00A859] text-xs font-bold">
      {l.success}
    </div>
    <div id="contact-feedback-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-bold">
      {l.error}
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('ayegroupe-contact-form');
  const successBox = document.getElementById('contact-feedback-success');
  const errorBox = document.getElementById('contact-feedback-error');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successBox && errorBox && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      successBox.classList.add('hidden');
      errorBox.classList.add('hidden');
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-60', 'cursor-not-allowed');

      const formData = new FormData(form);

      try {
        const { supabase } = await import('../lib/supabase');
        const { error } = await supabase.from('contact_submissions').insert({
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone') || null,
          pole: formData.get('pole'),
          message: formData.get('message'),
          lang: form.dataset.lang,
        });

        if (error) throw error;

        successBox.classList.remove('hidden');
        form.reset();
      } catch (err) {
        console.error('Contact form submission failed:', err);
        errorBox.classList.remove('hidden');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-60', 'cursor-not-allowed');
      }
    });
  }
</script>
