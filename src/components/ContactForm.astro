---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const labels = {
  fr: {
    title: 'Transmettez-nous votre demande',
    subtitle: 'Nos experts vous répondent sous 24 heures ouvrées.',
    name: 'Nom complet ou Raison sociale *',
    email: 'Adresse email professionnelle *',
    phone: 'Numéro de téléphone / WhatsApp',
    pole: 'Pôle d\'activité concerné *',
    selectPole: 'Sélectionnez un pôle',
    poleIt: 'Pôle IT & Ingénierie logicielle (International)',
    poleTogo: 'Pôle Togo (Fourniture IT, Matériel, Logistique)',
    poleSaas: 'Solutions SaaS & Création de plateforme',
    poleOther: 'Autre demande / Partenariat',
    message: 'Détail de votre besoin ou projet *',
    placeholderMsg: 'Précisez vos objectifs, délais et contraintes...',
    submit: 'Envoyer ma demande',
    sending: 'Envoi en cours...',
    success: 'Merci ! Votre message a été transmis avec succès. Nous reviendrons vers vous très rapidement.',
    directOr: 'Ou contactez directement nos équipes :',
  },
  en: {
    title: 'Send us your inquiry',
    subtitle: 'Our specialists will get back to you within 24 business hours.',
    name: 'Full Name or Company *',
    email: 'Professional Email Address *',
    phone: 'Phone / WhatsApp Number',
    pole: 'Division Concerned *',
    selectPole: 'Select a business unit',
    poleIt: 'IT & Software Engineering (International)',
    poleTogo: 'Togo Hub (IT Supply, Hardware, Logistics)',
    poleSaas: 'SaaS Solutions & Custom Platforms',
    poleOther: 'Other inquiry / Strategic partnership',
    message: 'Project details or inquiry *',
    placeholderMsg: 'Describe your goals, timeline, and expectations...',
    submit: 'Submit Inquiry',
    sending: 'Submitting...',
    success: 'Thank you! Your message has been sent successfully. We will follow up with you promptly.',
    directOr: 'Or connect directly with our regional teams:',
  }
};

const l = labels[lang];
---

<div class="rounded-3xl bg-slate-900/90 border border-slate-700/80 p-8 sm:p-12 backdrop-blur-xl shadow-2xl">
  <div class="mb-8">
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
      {l.title}
    </h3>
    <p class="text-slate-400 text-sm sm:text-base mt-2">
      {l.subtitle}
    </p>
  </div>

  <form id="ayegroupe-contact-form" class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Name -->
      <div>
        <label for="contact-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
          {l.name}
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          class="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all text-sm"
          placeholder="Ex: Koffi Mensah / Entreprise SARL"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="contact-email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
          {l.email}
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          class="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all text-sm"
          placeholder="contact@votre-entreprise.com"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Phone / WhatsApp -->
      <div>
        <label for="contact-phone" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
          {l.phone}
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          class="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all text-sm"
          placeholder="+228 90 00 00 00"
        />
      </div>

      <!-- Pole Division Selector -->
      <div>
        <label for="contact-pole" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
          {l.pole}
        </label>
        <select
          id="contact-pole"
          name="pole"
          required
          class="w-full px-4 py-3.5 rounded-xl bg-slate-900 border border-white/10 text-white focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all text-sm"
        >
          <option value="" disabled selected>{l.selectPole}</option>
          <option value="it">{l.poleIt}</option>
          <option value="togo">{l.poleTogo}</option>
          <option value="saas">{l.poleSaas}</option>
          <option value="other">{l.poleOther}</option>
        </select>
      </div>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        {l.message}
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        class="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all text-sm resize-y"
        placeholder={l.placeholderMsg}
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-brand-blue hover:bg-brand-blue-dark text-white font-bold text-sm shadow-xl shadow-brand-blue/30 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>{l.submit}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
    </div>

    <!-- Feedback Message Box -->
    <div id="contact-feedback" class="hidden p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-sm">
      {l.success}
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('ayegroupe-contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('contact-feedback');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && feedback && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-60', 'cursor-not-allowed');

      // Simulate instantaneous UX feedback (can be wired to Formspree or custom API)
      setTimeout(() => {
        feedback.classList.remove('hidden');
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-60', 'cursor-not-allowed');
      }, 600);
    });
  }
</script>
