---
import { altPath, type Lang } from '../lib/i18n';

interface Props {
  currentLang: Lang;
  currentPath?: string;
}

const { currentLang, currentPath = '' } = Astro.props;

// La substitution de prefixe faite ici auparavant fabriquait des 404 sur les
// pages dont le slug change de langue (/fr/services-creatifs ->
// /en/services-creatifs). altPath connait les paires ; sans traduction, on
// renvoie vers l'accueil de la langue cible plutot que vers une page absente.
const targetLang: Lang = currentLang === 'fr' ? 'en' : 'fr';
const targetPath = altPath(currentPath, targetLang) ?? `/${targetLang}`;
---

<div class="inline-flex items-center rounded-full bg-slate-100 border border-slate-200 p-0.5 text-[11px] font-bold tracking-wider">
  <a
    href={currentLang === 'fr' ? '#' : targetPath}
    class={`px-3 py-1 rounded-full transition-all duration-150 ${
      currentLang === 'fr'
        ? 'bg-[#0C2340] text-white shadow-xs'
        : 'text-slate-600 hover:text-[#0C2340] hover:bg-slate-200/70'
    }`}
    aria-label="Passer en Français"
  >
    FR
  </a>
  <a
    href={currentLang === 'en' ? '#' : targetPath}
    class={`px-3 py-1 rounded-full transition-all duration-150 ${
      currentLang === 'en'
        ? 'bg-[#0C2340] text-white shadow-xs'
        : 'text-slate-600 hover:text-[#0C2340] hover:bg-slate-200/70'
    }`}
    aria-label="Switch to English"
  >
    EN
  </a>
</div>
