---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const poles = [
  {
    id: 'it',
    title: lang === 'fr' ? 'Pôle IT & Ingénierie Logicielle' : 'IT & Software Engineering Hub',
    scope: lang === 'fr' ? 'Portée Internationale · Remote & Consulting' : 'Global Scope · Remote & Enterprise Consulting',
    description: lang === 'fr'
      ? 'Développement d\'applications sur mesure, conseil en systèmes d\'information, architecture cloud, intégration de systèmes complexes et cybersécurité opérationnelle.'
      : 'Bespoke software development, IT architecture consulting, cloud migration, complex systems integration, and high-availability operational support.',
    highlights: lang === 'fr'
      ? ['Applications Web & Mobiles sur mesure', 'Architecture Cloud & Systèmes d\'information', 'Intégration d\'API & Bases de données', 'Ingénierie & Solutions SaaS monétisées']
      : ['Custom Web & Mobile Applications', 'Cloud & Systems Architecture', 'API Integration & Distributed Databases', 'Full-cycle Monetized SaaS Engineering'],
    link: `/${lang}/services-it`,
    linkText: lang === 'fr' ? 'Explorer les services IT' : 'Explore IT Services',
    badge: 'Tech & Innovation',
    colorTheme: 'blue',
    iconBg: 'bg-brand-blue/15 text-brand-blue-light border-brand-blue/30',
    cardBorder: 'hover:border-brand-blue/60',
  },
  {
    id: 'togo',
    title: lang === 'fr' ? 'Pôle Togo — Négoce & Logistique' : 'Togo Hub — Trade & Logistics',
    scope: lang === 'fr' ? 'Présence Locale & Afrique de l\'Ouest · Lomé' : 'Physical Operations & West Africa Hub · Lomé',
    description: lang === 'fr'
      ? 'Import-Export de marchandises générales, fourniture et maintenance d\'équipements IT et de bureau, solutions de stockage, transport et location de véhicules.'
      : 'General Trade import/export, supply and maintenance of IT & office hardware, warehousing, freight transport, and corporate vehicle fleet rentals.',
    highlights: lang === 'fr'
      ? ['General Trade & Import/Export international', 'Matériel informatique, mobilier & consommables', 'Logistique, entreposage & gestion des stocks', 'Location de véhicules de société à Lomé']
      : ['General Trade & International Sourcing', 'IT Hardware, office furniture & supplies', 'Freight logistics, warehousing & inventory', 'Corporate & utility vehicle leasing in Lomé'],
    link: `/${lang}/togo`,
    linkText: lang === 'fr' ? 'Découvrir le Pôle Togo' : 'Discover Togo Hub',
    badge: 'Opérations & Négoce',
    colorTheme: 'gold',
    iconBg: 'bg-brand-gold/15 text-brand-gold-light border-brand-gold/30',
    cardBorder: 'hover:border-brand-gold/60',
  },
  {
    id: 'saas',
    title: lang === 'fr' ? 'Vitrine Produits SaaS' : 'Proprietary SaaS Showcase',
    scope: lang === 'fr' ? 'Produits en Production · Millions de requêtes' : 'Live Products · Production Ready',
    description: lang === 'fr'
      ? 'La preuve vivante de notre savoir-faire : nous concevons, exploitons et monétisons nos propres plateformes SaaS comme AyePrep (EdTech) et AyeJob (Recrutement).'
      : 'Real-world proof of our engineering expertise: we architect, run, and scale profitable SaaS platforms like AyePrep (EdTech) and AyeJob (Recruitment).',
    highlights: lang === 'fr'
      ? ['AyePrep : Simulateur IA TCF / TEF Canada', 'AyeJob : Portail carrières & matching de talents', 'Paiements Stripe & Mobile Money intégrés', 'Prêts à concevoir votre prochain SaaS']
      : ['AyePrep : AI TEF / TCF exam simulator', 'AyeJob : Smart recruitment matchmaking', 'Integrated Stripe & Mobile Money', 'Ready to build your custom SaaS platform'],
    link: `/${lang}/saas`,
    linkText: lang === 'fr' ? 'Voir nos solutions SaaS' : 'View our SaaS portfolio',
    badge: 'Produits en Ligne',
    colorTheme: 'emerald',
    iconBg: 'bg-brand-emerald/15 text-emerald-400 border-brand-emerald/30',
    cardBorder: 'hover:border-brand-emerald/60',
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {poles.map((pole) => (
    <div class={`rounded-3xl bg-slate-900/80 border border-slate-800 ${pole.cardBorder} p-8 flex flex-col justify-between backdrop-blur-xl shadow-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl group`}>
      <div>
        <!-- Badge & Scope -->
        <div class="flex items-center justify-between gap-2 mb-6">
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border font-mono ${pole.iconBg}`}>
            {pole.badge}
          </span>
          <span class="text-[11px] text-slate-400 font-medium">
            {pole.scope}
          </span>
        </div>

        <!-- Title -->
        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-3 group-hover:text-brand-blue-light transition-colors">
          {pole.title}
        </h3>

        <!-- Description -->
        <p class="text-slate-300 text-sm leading-relaxed mb-6">
          {pole.description}
        </p>

        <!-- Highlights List -->
        <ul class="space-y-2.5 mb-8 border-t border-slate-800/80 pt-6">
          {pole.highlights.map((item) => (
            <li class="flex items-start gap-2.5 text-xs text-slate-300">
              <svg class="w-4 h-4 text-brand-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Action Link -->
      <a
        href={pole.link}
        class="inline-flex items-center justify-between w-full px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-sm border border-white/10 group-hover:border-white/25 transition-all duration-200"
      >
        <span>{pole.linkText}</span>
        <svg class="w-4 h-4 text-brand-blue-light group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  ))}
</div>
