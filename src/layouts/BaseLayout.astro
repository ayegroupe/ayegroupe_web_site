---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import type { Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  canonicalPath?: string;
  ogType?: string;
}

const {
  title,
  description,
  lang = 'fr',
  canonicalPath = '',
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://ayegroupe.com';
const canonicalUrl = `${siteUrl}${canonicalPath || Astro.url.pathname}`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Sur les pages du pôle Togo, le visiteur est local : lui proposer le numéro
// togolais plutôt qu'un appel international vers le Canada.
const whatsappPhone = Astro.url.pathname.includes('/togo') ? '+22890116744' : '+17788091060';

// Alternate hreflang
const frUrl = `${siteUrl}${canonicalPath.replace(/^\/(en|fr)/, '/fr') || '/fr'}`;
const enUrl = `${siteUrl}${canonicalPath.replace(/^\/(en|fr)/, '/en') || '/en'}`;

// JSON-LD Structured Data
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://ayegroupe.com/#organization",
      "name": "AYEGROUPE",
      "url": "https://ayegroupe.com",
      "logo": "https://ayegroupe.com/logo/logo-ayegroupe-dark.svg",
      "description": "Entreprise individuelle d'ingénierie logicielle basée à Surrey, Canada, avec un hub commercial et logistique à Lomé, Togo.",
      "email": "ayegroupe@ayegroupe.com",
      "telephone": "+17788091060",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Surrey",
        "addressRegion": "BC",
        "addressCountry": "CA"
      },
      "sameAs": [
        "https://www.ayeprep.com",
        "https://www.ayejob.com"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://ayegroupe.com/#togo-hub",
      "name": "AYEGROUPE — Hub Togo",
      "description": "Fourniture IT & Bureautique, Import/Export et Logistique à Lomé, Togo.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lomé",
        "addressCountry": "TG"
      },
      "telephone": "+22890116744",
      "parentOrganization": {
        "@id": "https://ayegroupe.com/#organization"
      }
    }
  ]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | AYEGROUPE</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo/logo-icon.svg" />

    <!-- Multilingual Hreflang SEO -->
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | AYEGROUPE`} />
    <meta property="og:description" content={description} />
    <!-- Les réseaux sociaux (WhatsApp, LinkedIn, Facebook) n'affichent pas les
         SVG : l'aperçu de partage doit pointer vers une image matricielle. -->
    <meta property="og:image" content="https://ayegroupe.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://ayegroupe.com/og-image.png" />

    <!-- Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#0C2340] font-sans antialiased selection:bg-[#00A859] selection:text-white">
    <Header lang={lang} currentPath={Astro.url.pathname} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer lang={lang} />
    <WhatsAppButton lang={lang} phone={whatsappPhone} />

    <!-- Vercel Analytics est sans cookie : pas de consentement requis.
         GA4 en dépose, il n'est donc chargé qu'après acceptation — et la
         bannière ne s'affiche que si GA4 est effectivement configuré. -->
    <Analytics />
    {gaMeasurementId && <CookieConsent lang={lang} gaMeasurementId={gaMeasurementId} />}
  </body>
</html>
